# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=your-session-secret-here-change-in-production

# CMS Blue Button 2.0 OAuth
BB_CLIENT_ID=your-bluebutton-client-id
BB_CLIENT_SECRET=your-bluebutton-client-secret
BB_CALLBACK_URL=http://localhost:3000/auth/callback

# Blue Button API Base URLs
# Sandbox: https://sandbox.bluebutton.cms.gov
# Production: https://api.bluebutton.cms.gov
BB_AUTH_URL=https://sandbox.bluebutton.cms.gov/v1/o/authorize/
BB_TOKEN_URL=https://sandbox.bluebutton.cms.gov/v1/o/token/
BB_API_BASE=https://sandbox.bluebutton.cms.gov/v2/fhir

# Encryption key for PHI at rest (32 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
