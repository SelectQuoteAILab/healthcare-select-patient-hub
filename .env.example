# Server
PORT=3000
NODE_ENV=development

# Session (REQUIRED in production - app will not start without this)
SESSION_SECRET=your-session-secret-here-change-in-production

# Encryption (REQUIRED - app will not start without this)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Database path (optional, defaults to ./data/patient_hub.db)
# Set to /data/patient_hub.db on Render with persistent disk
DATABASE_PATH=

# CMS Blue Button 2.0 OAuth
BB_CLIENT_ID=your-bluebutton-client-id
BB_CLIENT_SECRET=your-bluebutton-client-secret
BB_CALLBACK_URL=http://localhost:3000/auth/callback
BB_REDIRECT_URI=http://localhost:3000/auth/callback
BB_ENV=sandbox

# Blue Button API Base URLs
# Sandbox: https://sandbox.bluebutton.cms.gov
# Production: https://api.bluebutton.cms.gov
BB_AUTH_URL=https://sandbox.bluebutton.cms.gov/v1/o/authorize/
BB_TOKEN_URL=https://sandbox.bluebutton.cms.gov/v1/o/token/
BB_API_BASE=https://sandbox.bluebutton.cms.gov/v2/fhir

# App URL (for CORS)
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# CSRF Secret (auto-generated if not set)
CSRF_SECRET=
